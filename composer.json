{
    "name": "jutsuworks/ge-commerce",
    "description": "Standalone, zero-bloat WordPress E-Commerce Core engine built on custom tables and Hexagonal Architecture.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "GeCommerce\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GeCommerce\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --testsuite Unit"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
